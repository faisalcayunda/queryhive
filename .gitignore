.venv/
build/
dist/
__pycache__/
*.pyc
*.spec

# Native app build artifacts. app/engine-requirements.txt is NOT ignored: it is the
# committed, fully pinned lockfile build-engine.sh reuses instead of re-resolving.
app/.build/
app/.engine/

# macOS and archive cruft that arrived with the checkout.
.DS_Store
__MACOSX/
backup.zip

# pywebview spikes, not tests: they are named test_* so pytest would collect them, and each
# one opens a GUI window when it runs.
/test_mac.py
/test_menu.py

# Rust build artifacts
/target

# Secrets. `.env` holds the kenari API key used by the local search helper, and it
# was NOT ignored before this line was added -- which is exactly how a key ends up
# in a commit. `git check-ignore -v .env` is the test that it stayed covered.
.env
.env.*

# Internal development tooling, deliberately kept out of the repository.
# `tools/kenari_search.py` is a local helper for researching while the app is
# being built. It is not something the project ships, so it does not belong in
# the tree that describes the product -- the same reason a scratch script is not
# committed. It stays on disk and reads its key from the `.env` above.
#
# Consequence worth remembering: a fresh clone does not have this file. What it
# does is documented in PROGRESS.md, so it can be recreated rather than
# discovered missing.
tools/kenari_search.py
