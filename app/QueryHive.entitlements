<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID / notarized build (app/build-dmg.sh --developer-id).

  Only the hardened runtime needs these; the ad-hoc build uses none of them. They exist because
  the engine is a Rust dylib loaded across the FFI boundary rather than a Mach-O inside the
  bundle: `libqh_ffi.dylib` is linked out of `target/release/deps` and is not signed with the
  app's own identity. ADR-0014 is the decision record and argues both keys.

  NOT YET VERIFIED against a real Developer ID: this machine has no such certificate, so the
  first notarized build must be launched and its engine exercised (Test Connection, then an
  export) before it is published.
-->
<plist version="1.0">
<dict>
  <!-- The engine library is loaded from outside the bundle and carries none of the app's
       signature. The hardened runtime validates each loaded library against the main
       executable's signing team, so without this the app dies at launch before any of its
       own code runs. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Kept for the FFI call path rather than for the engine's own code: the Swift/libffi
       marshalling layer around a call into Rust allocates executable pages, which the
       hardened runtime refuses by default. The Rust crates themselves forbid `unsafe_code`
       and need no writable-executable memory of their own. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
