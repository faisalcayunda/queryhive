<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID / notarized build (app/build-dmg.sh --developer-id).

  Only the hardened runtime needs these; the ad-hoc build uses none of them. They exist because
  the app carries its own CPython, which loads C extension modules out of the bundle at runtime —
  something the hardened runtime otherwise refuses.

  NOT YET VERIFIED against a real Developer ID: this machine has no such certificate, so the
  first notarized build must be launched and its engine exercised (Test Connection, then an
  export) before it is published.
-->
<plist version="1.0">
<dict>
  <!-- Every extension module (.so) is dlopen'd from Contents/Resources/engine/site-packages.
       The hardened runtime validates each library against the signing team, and a bundled
       interpreter fails to import any of them without this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- ctypes and a few C extensions map writable-executable pages. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
